---
/**
 * Sayfa sonu aksiyon bandı — WhatsApp-first iletişim.
 */
import { CONTACT } from '../data/site';
import { whatsappQuoteEn } from '../data/en/site';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';

interface Props {
  title?: string;
  text?: string;
  /** WhatsApp mesajına girecek konu */
  topic?: string;
}

const locale = Astro.currentLocale === 'en' ? 'en' : 'tr';
const ui = t(locale);
const {
  title = ui.ctaTitle,
  text = ui.ctaText,
  topic = ui.ctaTopic,
} = Astro.props;
const waHref = locale === 'en' ? whatsappQuoteEn(topic) : CONTACT.whatsappQuote(topic);
---

<section class="cta-band band-dark">
  <div class="container cta-in">
    <div class="cta-text reveal">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions reveal" style="--reveal-delay:.1s">
      <a href={waHref} class="btn btn--primary btn--lg" target="_blank" rel="noopener">
        {ui.ctaWa}
      </a>
      <a href={CONTACT.phoneHref} class="btn btn--outline btn--lg cta-tel">
        <Icon name="telefon" size={18} />
        {CONTACT.phoneDisplay}
      </a>
    </div>
    <p class="cta-alt reveal" style="--reveal-delay:.18s">
      {ui.ctaMailPrefix} <a href={`mailto:${CONTACT.emailInfo}`}>{CONTACT.emailInfo}</a>
    </p>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--section-y);
    text-align: center;
  }

  .cta-in {
    display: grid;
    justify-items: center;
    gap: var(--sp-6);
  }

  .cta-text h2 {
    color: var(--white);
    max-width: 24ch;
    margin-inline: auto;
  }

  .cta-text p {
    margin-top: var(--sp-4);
    margin-inline: auto;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-4);
  }

  .cta-alt {
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .cta-alt a {
    color: var(--green-400);
  }
</style>
