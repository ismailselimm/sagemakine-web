---
import Logo from './Logo.astro';
import { SITE, CONTACT, SECTORS } from '../data/site';

const yil = new Date().getFullYear();

const makineLinks = [
  { label: 'Renk Ayırma Makineleri', href: '/renk-ayirma-makinesi/' },
  { label: 'Oluk Tipi Renk Ayırma', href: '/renk-ayirma-makinesi/oluk-tipi/' },
  { label: 'Bant Tipi Renk Ayırma', href: '/renk-ayirma-makinesi/bant-tipi/' },
  { label: 'X-Ray Gıda Kontrol', href: '/x-ray-gida-kontrol-makinesi/' },
  { label: 'Dökme Ürün X-Ray', href: '/x-ray-gida-kontrol-makinesi/dokme-urun/' },
  { label: 'Paketli Ürün X-Ray', href: '/x-ray-gida-kontrol-makinesi/paketli-urun/' },
];

const kurumsalLinks = [
  { label: 'Hakkımızda', href: '/hakkimizda/' },
  { label: 'Servis & Yedek Parça', href: '/servis-yedek-parca/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'İletişim', href: '/iletisim/' },
  { label: 'KVKK Aydınlatma Metni', href: '/kvkk/' },
];
---

<footer class="site-footer band-dark">
  <!-- devre çizgisi ayracı (logodan türetilmiş motif) -->
  <svg class="circuit" viewBox="0 0 1200 24" preserveAspectRatio="none" aria-hidden="true">
    <polyline
      points="0,12 420,12 444,2 780,2 804,12 1200,12"
      fill="none"
      stroke="rgba(122,171,53,0.5)"
      stroke-width="1.5"></polyline>
    <circle cx="420" cy="12" r="3" fill="#7aab35"></circle>
    <circle cx="804" cy="12" r="3" fill="#7aab35"></circle>
  </svg>

  <div class="container container--wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="dark" height={46} />
        <p class="footer-tagline" lang="en">SMART&nbsp;· AUTOMATION&nbsp;· GLOBAL&nbsp;· ENGINEERING</p>
        <p class="footer-desc">
          Kuru meyve, kuruyemiş ve bakliyat işleyicileri için renk ayırma ve X-Ray gıda kontrol
          makineleri. Manisa merkezli satış, kurulum ve teknik servis.
        </p>
        <address class="footer-contact">
          <a href={CONTACT.mapsLink} target="_blank" rel="noopener">{CONTACT.address.full}</a>
          <a href={CONTACT.phoneHref} class="mono">{CONTACT.phoneDisplay}</a>
          <a href={`mailto:${CONTACT.emailInfo}`} class="mono">{CONTACT.emailInfo}</a>
        </address>
        <a href={CONTACT.whatsapp} class="btn btn--primary" target="_blank" rel="noopener">
          WhatsApp'tan Yazın
        </a>
      </div>

      <nav class="footer-col" aria-label="Makineler">
        <h2>Makineler</h2>
        <ul>
          {makineLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Sektörler">
        <h2>Sektörler</h2>
        <ul>
          {SECTORS.map((s) => (
            <li><a href={`/sektorler/${s.slug}/`}>{s.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Kurumsal">
        <h2>Kurumsal</h2>
        <ul>
          {kurumsalLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>© {yil} {SITE.legalName} Tüm hakları saklıdır.</p>
      <p class="mono footer-loc">Yunusemre / Manisa · Türkiye geneli satış, kurulum ve servis</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
  }

  .circuit {
    display: block;
    width: 100%;
    height: 24px;
    background: var(--paper);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: var(--sp-8);
    padding-block: var(--sp-8) var(--sp-7);
  }

  .footer-brand {
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
  }

  .footer-tagline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--green-400);
  }

  .footer-desc {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    max-width: 34ch;
  }

  .footer-contact {
    display: grid;
    gap: var(--sp-2);
    font-style: normal;
    font-size: var(--text-sm);
  }

  .footer-contact a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .footer-contact a:hover {
    color: var(--green-400);
  }

  .mono {
    font-family: var(--font-mono);
  }

  .footer-col h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-400);
    margin-bottom: var(--sp-4);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }

  .footer-col a {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
    transition: color var(--dur) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--white);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    justify-content: space-between;
    padding-block: var(--sp-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .footer-loc {
    letter-spacing: 0.06em;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
