---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import forpusYazi from '../assets/brand/forpus-yazi.png';
import { SITE, CONTACT, SECTORS, MAKINE_GRUPLARI, KURUMSAL_LINKS } from '../data/site';

const yil = new Date().getFullYear();
const makineLinks = MAKINE_GRUPLARI.flatMap((g) => g.items);
const kurumsalLinks = KURUMSAL_LINKS;
---

<footer class="site-footer band-dark">
  <div class="container container--wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="dark" full height={84} />
        <p class="footer-desc">{SITE.description}</p>
        <address class="footer-contact">
          <a href={CONTACT.mapsLink} target="_blank" rel="noopener">{CONTACT.address.full}</a>
          <a href={CONTACT.phoneHref} class="mono">{CONTACT.phoneDisplay}</a>
          <a href={`mailto:${CONTACT.emailInfo}`} class="mono">{CONTACT.emailInfo}</a>
        </address>
        <a href={CONTACT.whatsapp} class="btn btn--primary" target="_blank" rel="noopener">
          WhatsApp'tan Yazın
        </a>
      </div>

      <nav class="footer-col" aria-label="Makineler">
        <h2>Makineler</h2>
        <ul>
          {makineLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Sektörler">
        <h2>Sektörler</h2>
        <ul>
          {SECTORS.map((s) => (
            <li><a href={`/sektorler/${s.slug}/`}>{s.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Kurumsal">
        <h2>Kurumsal</h2>
        <ul>
          {kurumsalLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>© {yil} {SITE.legalName} · Tüm hakları saklıdır.</p>
      <p class="mono footer-loc">Yunusemre / Manisa · Türkiye geneli satış, kurulum ve servis</p>
    </div>

    <!-- Forpus imzası -->
    <div class="footer-imza">
      <a
        href="https://forpusyazilim.com/"
        target="_blank"
        rel="noopener"
        aria-label="Forpus Yazılım tarafından geliştirildi"
      >
        <span class="imza-text">Geliştiren</span>
        <span class="imza-chip">
          <Image src={forpusYazi} alt="Forpus Yazılım" height={22} width={74} densities={[1, 2, 3]} />
        </span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    /* sayfa → footer geçişi: düz, sade, yumuşak iç gölge */
    box-shadow: inset 0 18px 28px -22px rgb(0 0 0 / 0.45);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: var(--sp-8);
    padding-block: var(--sp-8) var(--sp-7);
  }

  .footer-brand {
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
  }

  .footer-desc {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    max-width: 34ch;
  }

  .footer-contact {
    display: grid;
    gap: var(--sp-2);
    font-style: normal;
    font-size: var(--text-sm);
  }

  .footer-contact a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .footer-contact a:hover {
    color: var(--green-400);
  }

  .mono {
    font-family: var(--font-mono);
  }

  .footer-col h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-400);
    margin-bottom: var(--sp-4);
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-2);
  }

  .footer-col a {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
    transition: color var(--dur) var(--ease-out);
  }

  .footer-col a:hover {
    color: var(--white);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    justify-content: space-between;
    padding-block: var(--sp-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .footer-loc {
    letter-spacing: 0.06em;
  }

  /* sabit WhatsApp butonu alt satırı örtmesin */
  @media (min-width: 900px) {
    .footer-bottom {
      padding-right: 11rem;
    }
  }

  /* ── Forpus imzası ── */
  .footer-imza {
    display: flex;
    justify-content: center;
    padding-bottom: var(--sp-5);
  }

  .footer-imza a {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    opacity: 0.75;
    transition: opacity var(--dur) var(--ease-out);
  }

  .footer-imza a:hover {
    opacity: 1;
  }

  .imza-text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .imza-chip {
    display: inline-flex;
    background: #ffffff;
    padding: 5px 9px;
    border-radius: 6px;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
