---
/**
 * SAGE logo — ORİJİNAL logo görselinden (brand/logo-light.jpg) kayıpsız
 * şeffaflaştırılmış PNG (ffmpeg colorkey; AI yeniden çizim DEĞİL).
 * variant="color" → açık zeminlerde çıplak logo
 * variant="dark"  → koyu zeminlerde logo bozulmadan beyaz plakacık içinde
 */
import { Image } from 'astro:assets';
import logoImg from '../assets/brand/sage-logo.png';

interface Props {
  variant?: 'color' | 'dark';
  /** logo yüksekliği (px) */
  height?: number;
  class?: string;
}

const { variant = 'color', height = 44, class: className } = Astro.props;
const width = Math.round(height * (1170 / 280));
---

{
  variant === 'color' ? (
    <Image
      src={logoImg}
      alt="SAGE Makine"
      height={height}
      width={width}
      densities={[1, 2]}
      class:list={['sage-logo', className]}
    />
  ) : (
    <span class:list={['sage-logo-chip', className]}>
      <Image src={logoImg} alt="SAGE Makine" height={height} width={width} densities={[1, 2]} />
    </span>
  )
}

<style>
  .sage-logo-chip {
    display: inline-flex;
    background: #ffffff;
    padding: 10px 14px;
    border-radius: 8px;
    box-shadow: 0 2px 14px rgb(0 0 0 / 0.28);
  }
</style>
