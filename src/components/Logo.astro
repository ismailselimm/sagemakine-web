---
/**
 * SAGE logo — Adem'in resmi kurumsal logosu (2026-07-25; telif kaygısıyla
 * ChatGPT üretimi eski logo bununla değiştirildi).
 * compact → ikon + SAGE + slogan satırı (header)
 * full    → + "Endüstriyel Makine Servis Ltd Şti" ünvan satırı (footer)
 * variant="dark" → koyu zeminde beyaz plakacık içinde
 */
import { Image } from 'astro:assets';
import logoCompact from '../assets/brand/sage-logo.png';
import logoFull from '../assets/brand/sage-logo-full.png';

interface Props {
  variant?: 'color' | 'dark';
  /** logo yüksekliği (px) */
  height?: number;
  /** ünvan satırı dahil tam kilit (footer) */
  full?: boolean;
  class?: string;
}

const { variant = 'color', height = 44, full = false, class: className } = Astro.props;
const logo = full ? logoFull : logoCompact;
const width = Math.round(height * (logo.width / logo.height));
---

<span class:list={['sage-lockup', variant === 'dark' && 'sage-lockup--chip', className]}>
  <Image src={logo} alt="SAGE Makine" height={height} width={width} densities={[1, 2]} />
</span>

<style>
  .sage-lockup {
    display: inline-flex;
  }

  .sage-lockup--chip {
    background: #ffffff;
    padding: 12px 18px;
    border-radius: 10px;
    box-shadow: 0 2px 14px rgb(0 0 0 / 0.28);
  }
</style>
