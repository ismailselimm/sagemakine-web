---
/**
 * Gerçek makine modelleri kart ızgarası — renk ayırma pillar sayfasında
 * TR ve EN tarafından paylaşılır. Stiller src/styles/pillar-renk.css içinde.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Model {
  img: ImageMetadata;
  tag: string;
  ad: string;
  text: string;
}

interface Props {
  modeller: Model[];
  /** alt metninde model adından sonra gelen ek: "renk ayırma makinesi" / "color sorter" */
  altSuffix: string;
}

const { modeller, altSuffix } = Astro.props;
---

<div class="model-grid">
  {
    modeller.map((m, i) => (
      <div class="card reveal" style={`--reveal-delay:${i * 0.08}s`}>
        <div class="model-img">
          <Image
            src={m.img}
            alt={`${m.ad} ${altSuffix}`}
            widths={[480, 760, 1000]}
            sizes="(max-width: 900px) 100vw, (max-width: 1480px) 30vw, 443px"
          />
        </div>
        <div class="model-body">
          <p class="mono-tag">{m.tag}</p>
          <h3>{m.ad}</h3>
          <p>{m.text}</p>
        </div>
      </div>
    ))
  }
</div>
