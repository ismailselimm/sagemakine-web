---
/**
 * Alt ürün sayfası şablonu (oluk/bant tipi, dökme/paketli X-Ray).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import CtaBand from './CtaBand.astro';
import Icon from './Icon.astro';
import { CONTACT } from '../data/site';

export interface UrunGrubu {
  baslik: string;
  urunler: string[];
}

interface Props {
  metaTitle: string;
  metaDescription: string;
  path: string;
  parent: { name: string; path: string };
  eyebrow: string;
  title: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  urunGruplari: UrunGrubu[];
  avantajlar: { icon: string; baslik: string; text: string }[];
  sektorler: { label: string; href: string }[];
  waTopic: string;
  ctaTitle: string;
}

const {
  metaTitle,
  metaDescription,
  path,
  parent,
  eyebrow,
  title,
  lead,
  image,
  imageAlt,
  urunGruplari,
  avantajlar,
  sektorler,
  waTopic,
  ctaTitle,
} = Astro.props;

const breadcrumbs = [parent, { name: title, path }];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  path={path}
  breadcrumbs={breadcrumbs}
>
  <PageHero eyebrow={eyebrow} title={title} lead={lead} breadcrumbs={breadcrumbs}>
    <Fragment slot="actions">
      <a href={CONTACT.whatsappQuote(waTopic)} class="btn btn--primary" target="_blank" rel="noopener">Teklif Alın</a>
      <a href={parent.path} class="btn btn--outline sub-ghost">{parent.name} ↰</a>
    </Fragment>
    <Fragment slot="visual">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 760, 1100]}
        sizes="(max-width: 900px) 100vw, 42vw"
        loading="eager"
        fetchpriority="high"
      />
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="container sub-grid">
      <div>
        <p class="eyebrow reveal">Hangi Ürünler İçin?</p>
        <h2 class="reveal">Bu Tipin Sahası</h2>
        <div class="grup-list">
          {
            urunGruplari.map((g, i) => (
              <div class="grup reveal" style={`--reveal-delay:${i * 0.08}s`}>
                <h3>{g.baslik}</h3>
                <ul>
                  {g.urunler.map((u) => (
                    <li>
                      <Icon name="check" size={15} /> {u}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
      <div>
        <p class="eyebrow reveal">Avantajlar</p>
        <h2 class="reveal">Neden Bu Tip?</h2>
        <div class="av-list">
          {
            avantajlar.map((a, i) => (
              <div class="av card reveal" style={`--reveal-delay:${i * 0.08}s`}>
                <span class="av-icon">
                  <Icon name={a.icon as any} size={22} />
                </span>
                <div>
                  <h3>{a.baslik}</h3>
                  <p>{a.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight band-sunken">
    <div class="container">
      <p class="eyebrow">İlgili Sektörler</p>
      <nav class="sektor-strip" aria-label="İlgili sektörler">
        {sektorler.map((s) => <a href={s.href}>{s.label}</a>)}
      </nav>
    </div>
  </section>

  <CtaBand
    title={ctaTitle}
    text="Numune ürününüzü test edelim; kapasite, taşıma oranı ve yerleşimi birlikte netleştirelim."
    topic={waTopic}
  />
</BaseLayout>

<style>
  .sub-ghost {
    border-color: var(--line-strong);
    color: var(--white);
  }

  .sub-ghost:hover {
    border-color: var(--green-400);
    color: var(--green-400);
  }

  .sub-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--sp-8);
    align-items: start;
  }

  .grup-list {
    display: grid;
    gap: var(--sp-5);
    margin-top: var(--sp-5);
  }

  .grup h3 {
    font-size: var(--text-md);
    margin-bottom: var(--sp-3);
    padding-bottom: var(--sp-2);
    border-bottom: 2px solid var(--green-500);
    display: inline-block;
  }

  .grup ul {
    display: grid;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
  }

  .grup li {
    display: flex;
    align-items: center;
    gap: 0.55em;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .grup li :global(svg) {
    color: var(--accent-ink);
    flex-shrink: 0;
  }

  .av-list {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }

  .av {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-5);
    align-items: start;
  }

  .av-icon {
    display: inline-flex;
    padding: 0.6rem;
    border-radius: var(--radius-md);
    background: var(--green-100);
    color: var(--accent-ink);
    flex-shrink: 0;
  }

  .av h3 {
    font-size: var(--text-md);
    margin-bottom: var(--sp-1);
  }

  .av p {
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .sektor-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }

  .sektor-strip a {
    padding: 0.5em 1em;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    transition: all var(--dur) var(--ease-out);
  }

  .sektor-strip a:hover {
    border-color: var(--green-500);
    color: var(--accent-ink);
    background: var(--green-100);
  }

  @media (max-width: 900px) {
    .sub-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
