---
import { CONTACT } from '../data/site';
---

<a
  href={CONTACT.whatsapp}
  class="wa-fab"
  target="_blank"
  rel="noopener"
  aria-label="WhatsApp üzerinden bize yazın"
>
  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
    <path
      d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2Zm0 18.1c-1.48 0-2.94-.4-4.2-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.25-8.24 8.25Zm4.52-6.16c-.25-.13-1.47-.72-1.7-.8-.22-.09-.39-.13-.55.12-.17.25-.64.8-.78.97-.15.16-.29.18-.54.06-.24-.13-1.04-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"
    ></path>
  </svg>
  <span class="wa-label">WhatsApp</span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: var(--z-fab);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.85em;
    background: #128c42;
    color: #fff;
    border-radius: var(--radius-pill);
    text-decoration: none;
    box-shadow: 0 6px 20px rgb(18 140 66 / 0.4);
    transition: transform var(--dur) var(--ease-spring), box-shadow var(--dur) var(--ease-out);
  }

  .wa-fab:hover {
    transform: translateY(-3px) scale(1.04);
    background: #0f7a39;
    box-shadow: 0 10px 28px rgb(18 140 66 / 0.5);
    color: #fff;
  }

  .wa-label {
    display: none;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 110;
    font-size: var(--text-sm);
    font-weight: 600;
    padding-right: 0.35em;
  }

  @media (min-width: 900px) {
    .wa-label {
      display: inline;
    }
  }
</style>
