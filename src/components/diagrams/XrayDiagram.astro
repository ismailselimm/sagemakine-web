---
/**
 * X-Ray gıda kontrol sistemi çalışma prensibi — şematik kesit (SVG).
 * Akış: konveyör → X-ışını jeneratörü → dedektör → görüntü işleme →
 * reddetme sistemi → sağlam ürün / ıskarta.
 */
---

<figure class="diagram">
  <svg
    viewBox="0 0 860 504"
    role="img"
    aria-label="X-Ray gıda kontrol sistemi şeması: konveyörden geçen ürün X-ışını jeneratörü ile taranır, dedektör görüntüsü işlenir ve yabancı madde içeren ürün reddetme sistemiyle ıskartaya ayrılır"
  >
    <defs>
      <marker id="xarr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#5f7080"></path>
      </marker>
      <marker id="xarrg" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#7aab35"></path>
      </marker>
    </defs>

    <!-- ── X-ışını jeneratörü ── -->
    <rect x="330" y="28" width="120" height="56" rx="8" fill="#16283f"></rect>
    <polygon points="380,84 372,100 388,100" fill="#16283f"></polygon>
    <text x="316" y="62" class="lbl lbl--end">X-Işını Jeneratörü</text>

    <!-- ışın yelpazesi -->
    <polygon points="380,100 300,236 460,236" fill="#7aab35" opacity="0.14"></polygon>
    <g stroke="#7aab35" stroke-width="1.8" stroke-dasharray="4 5" opacity="0.8">
      <line x1="380" y1="100" x2="304" y2="234"></line>
      <line x1="380" y1="100" x2="380" y2="234"></line>
      <line x1="380" y1="100" x2="456" y2="234"></line>
    </g>

    <!-- ── Konveyör ── -->
    <rect x="60" y="240" width="640" height="16" rx="8" fill="#cbd3db" stroke="#16283f" stroke-width="2.5"></rect>
    <circle cx="84" cy="248" r="5" fill="#5f7080"></circle>
    <circle cx="380" cy="248" r="5" fill="#5f7080"></circle>
    <circle cx="676" cy="248" r="5" fill="#5f7080"></circle>
    <text x="60" y="290" class="lbl">Konveyör Bant</text>
    <line x1="130" y1="222" x2="196" y2="222" stroke="#5f7080" stroke-width="2" marker-end="url(#xarr)"></line>

    <!-- ürünler bant üzerinde -->
    <g>
      <rect x="96" y="206" width="58" height="30" rx="4" fill="#f2f5f7" stroke="#5f7080" stroke-width="2"></rect>
      <rect x="352" y="206" width="58" height="30" rx="4" fill="#f2f5f7" stroke="#16283f" stroke-width="2"></rect>
      <!-- taranan üründe yabancı madde -->
      <circle cx="388" cy="224" r="5.5" fill="#16283f"></circle>
      <rect x="560" y="206" width="58" height="30" rx="4" fill="#f2f5f7" stroke="#5f7080" stroke-width="2"></rect>
    </g>

    <!-- ── Dedektör ── -->
    <rect x="300" y="262" width="160" height="14" rx="3" fill="#1e3a5f"></rect>
    <text x="300" y="300" class="lbl">Dedektör Hattı</text>

    <!-- ── Görüntü işleme ── -->
    <rect x="586" y="52" width="170" height="110" rx="8" fill="#0f1c2e"></rect>
    <rect x="600" y="66" width="142" height="82" rx="4" fill="#16283f"></rect>
    <!-- mini tarama görüntüsü -->
    <g opacity="0.85">
      <ellipse cx="636" cy="96" rx="12" ry="8" fill="#3d4c5a"></ellipse>
      <ellipse cx="668" cy="112" rx="12" ry="8" fill="#3d4c5a"></ellipse>
      <ellipse cx="700" cy="92" rx="12" ry="8" fill="#3d4c5a"></ellipse>
      <circle cx="672" cy="98" r="5" fill="#ffffff"></circle>
      <circle cx="672" cy="98" r="9" fill="none" stroke="#7aab35" stroke-width="2"></circle>
    </g>
    <text x="586" y="182" class="lbl">Görüntü İşleme</text>
    <path d="M460,270 Q560,262 600,160" fill="none" stroke="#5f7080" stroke-width="2" stroke-dasharray="5 5" marker-end="url(#xarr)"></path>

    <!-- ── Reddetme sistemi ── -->
    <rect x="600" y="308" width="26" height="64" rx="4" fill="#1e3a5f"></rect>
    <line x1="613" y1="372" x2="613" y2="396" stroke="#1e3a5f" stroke-width="8" stroke-linecap="round"></line>
    <text x="640" y="342" class="lbl">Reddetme Sistemi</text>
    <text x="640" y="364" class="lbl lbl--small">itici kol / hava jeti</text>

    <!-- akışlar -->
    <line x1="700" y1="248" x2="790" y2="248" stroke="#7aab35" stroke-width="2.4" marker-end="url(#xarrg)"></line>
    <text x="742" y="230" class="lbl lbl--green lbl--mid">Sağlam</text>

    <path d="M613,400 Q613,428 560,436" fill="none" stroke="#5f7080" stroke-width="2.4" marker-end="url(#xarr)"></path>
    <!-- ıskarta haznesi -->
    <polygon points="468,428 552,428 536,468 484,468" fill="#e4e9ed" stroke="#5f7080" stroke-width="2.5"></polygon>
    <text x="510" y="494" class="lbl lbl--mid lbl--soft">Iskarta</text>
  </svg>
  <figcaption>
    X-ışını, üründen geçerken yoğunluk farklarını görüntüler: taş, cam, metal ve kemik —
    ambalajın içinde dahi — milisaniyeler içinde tespit edilir ve reddetme sistemi kusurlu ürünü
    hat dışına alır.
  </figcaption>
</figure>

<style>
  .diagram {
    margin: 0;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
  }

  .diagram svg {
    width: 100%;
    height: auto;
  }

  .lbl {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.04em;
    fill: var(--ink-soft);
  }

  .lbl--small {
    font-size: 12.5px;
    fill: var(--ink-faint);
  }

  .lbl--end {
    text-anchor: end;
  }

  /* dar ekranda viewBox küçüldüğü için etiketleri büyüt */
  @media (max-width: 640px) {
    .lbl {
      font-size: 26px;
    }
    .lbl--small {
      font-size: 20px;
    }
  }

  .lbl--mid {
    text-anchor: middle;
  }

  .lbl--green {
    fill: #4a6e1b;
    font-weight: 600;
  }

  .lbl--soft {
    fill: #5f7080;
  }

  figcaption {
    margin-top: var(--sp-3);
    font-size: var(--text-sm);
    color: var(--ink-faint);
    max-width: 70ch;
  }
</style>
