---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/tokens.css';
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';
import Seo, { type Breadcrumb } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { asLocale } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  type?: 'website' | 'article';
  breadcrumbs?: Breadcrumb[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const seoProps = Astro.props;
const lang = asLocale(Astro.currentLocale);
---

<!doctype html>
<html lang={lang}>
  <head>
    <script>
      document.documentElement.classList.add('js');
    </script>
    <Seo {...seoProps} />
    <ClientRouter />
  </head>
  <body>
    <a href="#icerik" class="skip-link">{t(lang).skipLink}</a>
    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      /* Scroll reveal — her sayfa yüklemesinde (ClientRouter geçişleri dahil) */
      function initReveal() {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
        /* geçiş sonrası olası scroll kilidini bırak (mobil menü açıkken gezinme) */
        document.documentElement.style.overflow = '';
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
</style>
