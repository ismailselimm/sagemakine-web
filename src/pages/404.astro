---
/**
 * GitHub Pages tüm eksik adresler için tek 404.html sunar (EN dahil) —
 * sayfa iki dilli: /en/ altındaki adreslerde küçük bir script EN bloğunu açar.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Sayfa Bulunamadı | SAGE Makine"
  description="Aradığınız sayfa bulunamadı."
  path="/404/"
  noindex
>
  <section class="section nf">
    <div class="container nf-in" data-l="tr">
      <p class="nf-code">404</p>
      <h1>Bu Sayfa Iskartaya Ayrılmış</h1>
      <p class="nf-text">
        Kameralarımız aradığınız sayfayı hat üzerinde bulamadı. Adres değişmiş veya hiç var olmamış
        olabilir — sağlam ürün aşağıdaki hatlarda.
      </p>
      <div class="nf-links">
        <a href="/" class="btn btn--primary">Ana Sayfa</a>
        <a href="/renk-ayirma-makinesi/" class="btn btn--outline">Renk Ayırma</a>
        <a href="/x-ray-gida-kontrol-makinesi/" class="btn btn--outline">X-Ray Kontrol</a>
        <a href="/iletisim/" class="btn btn--outline"><Icon name="telefon" size={16} /> İletişim</a>
      </div>
    </div>

    <div class="container nf-in" data-l="en" hidden>
      <p class="nf-code">404</p>
      <h1>This Page Went to the Reject Stream</h1>
      <p class="nf-text">
        Our cameras couldn't find the page you're looking for on the line. The address may have
        changed or never existed — the good product is on the lines below.
      </p>
      <div class="nf-links">
        <a href="/en/" class="btn btn--primary">Home</a>
        <a href="/en/color-sorter/" class="btn btn--outline">Color Sorters</a>
        <a href="/en/x-ray-food-inspection/" class="btn btn--outline">X-Ray Inspection</a>
        <a href="/en/contact/" class="btn btn--outline"><Icon name="telefon" size={16} /> Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* /en/ altında kaybolan ziyaretçiye İngilizce 404 göster.
     Modül ClientRouter'da kalıcı — 404 markup'ı yoksa dokunma (başlık ezme!). */
  function init404Lang() {
    const enBlok = document.querySelector('.nf-in[data-l="en"]');
    if (!enBlok || !location.pathname.startsWith('/en/')) return;
    document.querySelector('.nf-in[data-l="tr"]')?.setAttribute('hidden', '');
    enBlok.removeAttribute('hidden');
    document.documentElement.lang = 'en';
    document.title = 'Page Not Found | SAGE Makine';
  }
  document.addEventListener('astro:page-load', init404Lang);
</script>

<style>
  .nf {
    min-height: 55vh;
    display: grid;
    align-items: center;
  }

  .nf-in {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: var(--sp-4);
  }

  .nf-code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--accent-ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.4em 1.2em;
  }

  .nf-text {
    color: var(--ink-faint);
    max-width: 46ch;
  }

  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }
</style>
