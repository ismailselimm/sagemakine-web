---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';

const breadcrumbs = [{ name: 'Blog', path: '/blog/' }];

const yazilar = [
  {
    slug: 'renk-ayirma-makinesi-fiyatlari',
    kategori: 'Satın Alma Rehberi',
    baslik: 'Renk Ayırma Makinesi Fiyatları 2026: Neye Göre Değişir?',
    ozet: 'Fiyatı belirleyen 6 faktör, toplam sahip olma maliyeti ve doğru teklif isteme rehberi.',
    dk: 6,
  },
  {
    slug: 'x-ray-mi-metal-dedektor-mu',
    kategori: 'Teknoloji',
    baslik: 'X-Ray mı Metal Dedektör mü? Gıdada Yabancı Madde Tespiti',
    ozet: 'İki teknolojinin dürüst karşılaştırması: hangisi neyi görür, ne zaman hangisi yeter?',
    dk: 6,
  },
  {
    slug: 'sortex-makinasi-nedir',
    kategori: 'Terimler',
    baslik: 'Sortex Makinası Nedir? Color Sorter ile Farkı Var mı?',
    ozet: 'Jenerikleşen bir marka adının ardındaki gerçek: renk ayırma makinesi nedir, markadan önce neye bakılır?',
    dk: 4,
  },
  {
    slug: 'ikinci-el-renk-ayirma-makinesi',
    kategori: 'Satın Alma Rehberi',
    baslik: '2. El Renk Ayırma Makinesi Almadan Önce Bilmeniz Gerekenler',
    ozet: 'Düşük ilk yatırımın görünmeyen riskleri: ejektör ömrü, kamera eskimesi, yedek parça ve servis gerçeği.',
    dk: 6,
  },
];
---

<BaseLayout
  title="Blog – Ayıklama Teknolojisi Rehberleri | SAGE Makine"
  description="Renk ayırma ve X-Ray gıda kontrol teknolojisi üzerine dürüst rehberler: fiyat faktörleri, teknoloji karşılaştırmaları ve satın alma tavsiyeleri."
  path="/blog/"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Blog"
    title="Satmak İçin Değil, Doğru Karar İçin"
    lead="Ayıklama teknolojisine yatırım büyük karardır. Bu rehberleri, telefonda sorduğunuz soruların dürüst cevapları olarak yazıyoruz."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container container--wide">
      <div class="post-grid">
        {
          yazilar.map((y, i) => (
            <a href={`/blog/${y.slug}/`} class="post-card card reveal" style={`--reveal-delay:${(i % 2) * 0.08}s`}>
              <p class="post-kat">{y.kategori} · {y.dk} dk</p>
              <h2>{y.baslik}</h2>
              <p class="post-ozet">{y.ozet}</p>
              <span class="post-link">Yazıyı okuyun <Icon name="arrow" size={15} /></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
  }

  .post-card {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    padding: var(--sp-6);
    text-decoration: none;
  }

  .post-kat {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .post-card h2 {
    font-size: var(--text-xl);
  }

  .post-ozet {
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .post-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-top: var(--sp-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-ink);
  }

  .post-card:hover .post-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 800px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
