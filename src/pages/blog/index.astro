---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { YAZILAR } from '../../data/blog';

const breadcrumbs = [{ name: 'Blog', path: '/blog/' }];

const covers = import.meta.glob<{ default: ImageMetadata }>('../../assets/blog/*.png', {
  eager: true,
});
const coverOf = (name: string) => covers[`../../assets/blog/${name}.png`]?.default;
---

<BaseLayout
  title="Blog – Ayıklama Teknolojisi Rehberleri | SAGE Makine"
  description="Renk ayırma ve X-Ray gıda kontrol teknolojisi üzerine dürüst rehberler: fiyat faktörleri, teknoloji karşılaştırmaları ve satın alma tavsiyeleri."
  path="/blog/"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Blog"
    title="Satmak İçin Değil, Doğru Karar İçin"
    lead="Ayıklama teknolojisine yatırım büyük karardır. Bu rehberleri, telefonda sorduğunuz soruların dürüst cevapları olarak yazıyoruz."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container container--wide">
      <div class="post-grid">
        {
          YAZILAR.map((y, i) => {
            const cover = coverOf(y.cover);
            return (
              <a href={`/blog/${y.slug}/`} class="post-card card reveal" style={`--reveal-delay:${(i % 2) * 0.08}s`}>
                {cover && (
                  <div class="post-cover-thumb">
                    <Image
                      src={cover}
                      alt={y.coverAlt}
                      widths={[420, 640, 900]}
                      sizes="(max-width: 800px) 100vw, 42vw"
                    />
                  </div>
                )}
                <div class="post-body">
                  <p class="post-kat">{y.kategori} · {y.dk} dk</p>
                  <h2>{y.baslik}</h2>
                  <p class="post-ozet">{y.ozet}</p>
                  <span class="post-link">Yazıyı okuyun <Icon name="arrow" size={15} /></span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .post-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .post-cover-thumb {
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }

  .post-cover-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .post-card:hover .post-cover-thumb :global(img) {
    transform: scale(1.04);
  }

  .post-body {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    padding: var(--sp-6);
  }

  .post-kat {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .post-card h2 {
    font-size: var(--text-xl);
  }

  .post-ozet {
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .post-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin-top: var(--sp-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-ink);
  }

  .post-card:hover .post-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 800px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
