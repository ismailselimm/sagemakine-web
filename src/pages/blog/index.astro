---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { YAZILAR } from '../../data/blog';
import '../../styles/blog-index.css';

const breadcrumbs = [{ name: 'Blog', path: '/blog/' }];
---

<BaseLayout
  title="Blog – Ayıklama Teknolojisi Rehberleri | SAGE Makine"
  description="Renk ayırma ve X-Ray gıda kontrol teknolojisi üzerine dürüst rehberler: fiyat faktörleri, teknoloji karşılaştırmaları ve satın alma tavsiyeleri."
  path="/blog/"
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow="Blog"
    title="Satmak İçin Değil, Doğru Karar İçin"
    lead="Ayıklama teknolojisine yatırım büyük karardır. Bu rehberleri, telefonda sorduğunuz soruların dürüst cevapları olarak yazıyoruz."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container container--wide">
      <div class="post-grid">
        {
          YAZILAR.map((y, i) => (
              <a href={`/blog/${y.slug}/`} class="post-card card reveal" style={`--reveal-delay:${(i % 2) * 0.08}s; --media-ratio: 21 / 9`}>
                <div class="card-media">
                  <Image
                    src={y.cover}
                    alt={y.coverAlt}
                    width={900}
                    widths={[420, 640, 900]}
                    sizes="(max-width: 800px) 100vw, (max-width: 1570px) 42vw, 660px"
                  />
                </div>
                <div class="post-body">
                  <p class="mono-tag">{y.kategori} · {y.dk} dk</p>
                  <h2>{y.baslik}</h2>
                  <p class="post-ozet">{y.ozet}</p>
                  <span class="post-link">Yazıyı okuyun <Icon name="arrow" size={15} /></span>
                </div>
              </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

