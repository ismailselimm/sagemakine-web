---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import ColorSorterDiagram from '../../../components/diagrams/ColorSorterDiagram.astro';
import { SITE } from '../../../data/site';
import { SECTORS_EN, whatsappQuoteEn } from '../../../data/en/site';
import '../../../styles/pillar-renk.css';

import { MACHINE_IMAGES } from '../../../data/images';
import kameraImg from '../../../assets/photos/tech-kamera.png';

const { dmax, havaBlogu, lineIds, linePanorama } = MACHINE_IMAGES;

const breadcrumbs = [{ name: 'Color Sorter Machines', path: '/en/color-sorter/' }];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Color Sorter Machine',
    brand: { '@type': 'Brand', name: SITE.name },
    description:
      'Belt-type color sorters for dried fruit, nuts and produce. Optical sorting systems with high-resolution RGB cameras and air ejectors — the DMAX model, backed by installation, training and service across Turkey.',
    image: `${SITE.domain}/og/og-default.jpg`,
    url: `${SITE.domain}/en/color-sorter/`,
  },
];

const teknolojiler = [
  {
    icon: 'kamera',
    title: 'High-Resolution RGB Cameras',
    text: 'High-resolution RGB cameras pick up the slightest color deviation, spots and blemishes under LED lighting.',
  },
  {
    icon: 'ejektor',
    title: 'Precision Air Ejectors',
    text: 'A pinpoint burst of air removes the defective kernel from the line without disturbing the good product flow.',
  },
  {
    icon: 'dogruluk',
    title: 'Shape Sorting',
    text: "Geometry analysis catches stems, stalks and broken kernels even when they match the product's color.",
  },
  {
    icon: 'yazilim',
    title: 'Deep-Learning Classification',
    text: 'Deep-learning models learn complex defect patterns that conventional thresholds miss.',
  },
];

const kusurlar = [
  { icon: 'tas', label: 'Stones and soil' },
  { icon: 'cam', label: 'Glass and ceramic' },
  { icon: 'metal', label: 'Metal fragments' },
  { icon: 'kabuk', label: 'Shell and pit fragments' },
  { icon: 'sap', label: 'Stems, stalks and plant debris' },
  { icon: 'kuf', label: 'Moldy and rotten kernels' },
  { icon: 'renk', label: 'Color-defective kernels' },
  { icon: 'dogruluk', label: 'Dark, aflatoxin-suspect kernels' },
];

---

<BaseLayout
  title="Color Sorter Machines: Sales & Service | SAGE Makine"
  description="Belt-type color sorters with high-resolution RGB cameras: removal of color and shape defects. The DMAX model, installation and spare parts."
  path="/en/color-sorter/"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Optical Sorting Technology"
    title="Color Sorter Machines"
    lead="A color sorter — also known as an optical sorting machine — detects defective kernels and foreign material with cameras and removes them from the line with air ejectors. From dried fruit to pulses, in a belt-type configuration — our DMAX model — matched to your product."
    breadcrumbs={breadcrumbs}
  >
    <Fragment slot="actions">
      <a href={whatsappQuoteEn('Color sorter machines')} class="btn btn--primary" target="_blank" rel="noopener">Get a Quote</a>
      <a href="#models" class="btn btn--outline pillar-ghost">Explore Our Models</a>
    </Fragment>
    <Fragment slot="visual">
      <Image
        src={havaBlogu}
        alt="Air ejector block of a SAGE color sorter — precision air nozzles up close"
        widths={[480, 760, 1100]}
        sizes="(max-width: 900px) 100vw, 42vw"
        loading="eager"
        quality={70}
      />
    </Fragment>
  </PageHero>

  <!-- Nasıl çalışır -->
  <section class="section" id="how-it-works">
    <div class="container">
      <p class="eyebrow reveal">How It Works</p>
      <div class="howto-grid">
        <div class="howto-text reveal">
          <h2>Thousands of Kernels per Second,<br />Inspected One by One</h2>
          <ol class="howto-steps">
            <li><strong>Feed:</strong> Product is metered from the hopper onto the vibratory feeder in a steady, even flow.</li>
            <li><strong>Flow:</strong> Kernels travel down the chute — or across the belt in a single layer — forming a thin product curtain.</li>
            <li><strong>Scanning:</strong> High-resolution RGB cameras image every kernel under LED lighting.</li>
            <li><strong>Decision:</strong> The processor makes the accept-or-reject call within milliseconds.</li>
            <li><strong>Ejection:</strong> An air ejector fires a pinpoint burst to blow the defective kernel into the reject stream.</li>
          </ol>
        </div>
        <div class="reveal" style="--reveal-delay:.1s">
          <ColorSorterDiagram />
        </div>
      </div>
    </div>
  </section>

  <!-- Teknolojiler -->
  <section class="section band-sunken">
    <div class="container container--wide">
      <p class="eyebrow reveal">Cameras and Software</p>
      <h2 class="reveal">Four Technologies That See Defects</h2>
      <div class="tek-grid">
        {
          teknolojiler.map((t, i) => (
            <div class="tek card reveal" style={`--reveal-delay:${i * 0.08}s`}>
              <span class="tek-icon">
                <Icon name={t.icon as any} size={26} />
              </span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </div>
          ))
        }
      </div>
      <figure class="tek-figure reveal">
        <Image
          src={kameraImg}
          alt="High-resolution camera module and LED lighting inside the sorting chamber"
          widths={[700, 1100, 1500]}
          sizes="(max-width: 900px) 100vw, 74rem"
        />
        <figcaption class="mono-cap">CAMERA MODULE + LED LIGHTING — SORTING CHAMBER</figcaption>
      </figure>
    </div>
  </section>

  <!-- Modellerimiz -->
  <section class="section" id="models">
    <div class="container">
      <p class="eyebrow reveal">Our Models</p>
      <h2 class="reveal">Our Optical Sorting Machines</h2>
      <p class="sec-lead reveal">
        On the color sorting side we have two real models: the belt-type DMAX and the precision
        nut sorter IDS. We pin down the right one for your product together.
      </p>
      <div class="tip-grid">
        <a href="/en/machines/dmax/" class="tip-card card reveal">
          <div class="tip-img">
            <Image src={dmax} alt="DMAX belt-type color and shape sorter" widths={[480, 760]} sizes="(max-width:900px) 100vw, 40vw" />
          </div>
          <div class="tip-body">
            <h3>DMAX — Belt-Type</h3>
            <p>RGB color + shape sorting with a 360° camera cabin. Dried fruit, frozen produce, potato products.</p>
            <ul>
              <li><Icon name="check" size={15} /> Raisins, figs, apricots, walnut kernels</li>
              <li><Icon name="check" size={15} /> IQF fruit and vegetables, french fries</li>
              <li><Icon name="check" size={15} /> Gentle single-layer flow for fragile product</li>
            </ul>
            <span class="tip-link">Explore DMAX <Icon name="arrow" size={15} /></span>
          </div>
        </a>
        <a href="/en/machines/ids/" class="tip-card card reveal" style="--reveal-delay:.1s">
          <div class="tip-img">
            <Image src={lineIds} alt="IDS precision nut sorting and analysis line" widths={[480, 760]} sizes="(max-width:900px) 100vw, 40vw" />
          </div>
          <div class="tip-body">
            <h3>IDS — Precision Nuts</h3>
            <p>360° cameras, up to 10 channels in a single pass; defect + foreign-material detection and reporting.</p>
            <ul>
              <li><Icon name="check" size={15} /> Shelled and in-shell nuts</li>
              <li><Icon name="check" size={15} /> Sizing + classification</li>
              <li><Icon name="check" size={15} /> Production tracking and analysis report</li>
            </ul>
            <span class="tip-link">Explore IDS <Icon name="arrow" size={15} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Neleri ayıklar -->
  <section class="section band-sunken">
    <div class="container">
      <p class="eyebrow reveal">What Does It Remove?</p>
      <h2 class="reveal">What the Eye Misses, the Camera Doesn't</h2>
      <ul class="kusur-list">
        {
          kusurlar.map((k, i) => (
            <li class="reveal" style={`--reveal-delay:${(i % 4) * 0.06}s`}>
              <Icon name={k.icon as any} size={20} />
              {k.label}
            </li>
          ))
        }
      </ul>
    </div>
  </section>


  <!-- Anahtar teslim hat -->
  <section class="section band-sunken">
    <div class="container container--wide">
      <p class="eyebrow reveal">Line Solutions</p>
      <div class="sec-head reveal">
        <h2>From a Single Machine to a Complete Line</h2>
        <p>
          We plan elevators, feeding, sorting and inspection as one project — your machine never
          stands alone on the line.
        </p>
      </div>
      <figure class="hat-panorama reveal">
        <Image
          src={linePanorama}
          alt="Turnkey sorting line: elevators, feed hoppers, color sorter and packing line together"
          widths={[768, 1200, 1800, 2400]}
          sizes="(max-width: 1440px) 100vw, 1376px"
        />
        <figcaption class="mono-cap">TURNKEY LINE INSTALLATION — SAMPLE LAYOUT</figcaption>
      </figure>
      <figure class="hat-figure reveal" style="--reveal-delay:.1s">
        <Image
          src={lineIds}
          alt="Sorting line made up of feeding, sorting and analysis conveyor stages"
          widths={[700, 1100, 1500]}
          sizes="(max-width: 900px) 100vw, 74rem"
        />
        <figcaption class="mono-cap">FEED + SORT + INSPECT — IN-LINE ANALYSIS</figcaption>
      </figure>
    </div>
  </section>

  <!-- Dürüst satın alma rehberi -->
  <section class="section honest-band band-dark">
    <div class="container honest-in">
      <p class="eyebrow reveal">Ask the Right Questions</p>
      <h2 class="reveal">Don't Look at "Accuracy Percentage" Alone</h2>
      <div class="honest-grid">
        <div class="honest card-dark reveal">
          <h3><Icon name="dogruluk" size={20} /> Carryover</h3>
          <p>
            Carryover — good product lost to the reject stream — affects your operating profit as
            much as accuracy does. Always ask for the good-to-defect ratio of the reject stream in
            the quotation — we share ours openly.
          </p>
        </div>
        <div class="honest card-dark reveal" style="--reveal-delay:.08s">
          <h3><Icon name="kapasite" size={20} /> Air Consumption</h3>
          <p>
            The ejectors' air consumption means compressor investment and electricity bills. Ask
            for the L/min figure and the required pressure along with the quotation.
          </p>
        </div>
        <div class="honest card-dark reveal" style="--reveal-delay:.16s">
          <h3><Icon name="parca" size={20} /> The Service Reality</h3>
          <p>
            The machine comes from China; the service comes from Manisa. Ask whether critical parts
            such as ejector valves, cameras and LED modules are stocked in Turkey.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sektörler -->
  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Applications</p>
      <nav class="sektor-strip" aria-label="Industries">
        {SECTORS_EN.map((s) => <a href={`/en/industries/${s.slug}/`}>{s.title}</a>)}
      </nav>
    </div>
  </section>

  <CtaBand
    title="Get a Quote for Your Product"
    text="Tell us about your product, your capacity and your defect profile; we'll pin down the right model and configuration together."
    topic="Color sorter quotation"
  />
</BaseLayout>
