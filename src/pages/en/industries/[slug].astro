---
import SektorPage from '../../../components/SektorPage.astro';
import { SEKTORLER_EN } from '../../../data/en/sektorler';

export function getStaticPaths() {
  return SEKTORLER_EN.map((sektor) => ({ params: { slug: sektor.slug }, props: { sektor } }));
}

const { sektor } = Astro.props;
---

<SektorPage sektor={sektor} sektorler={SEKTORLER_EN} />
