---

<SubUrunPage
  metaTitle="In-Line Bulk Product X-Ray Sorting | SAGE Makine"
  metaDescription="In-line bulk X-ray systems that remove stone, glass, and metal from nut, pulse, and IQF flows before packing. Zoned rejection minimizes product loss."
  path="/en/x-ray-food-inspection/bulk-product/"
  parent={{name:"X-Ray Food Inspection Systems", path:"/en/x-ray-food-inspection/"}}
  eyebrow="X-Ray · Bulk Product"
  title="Bulk Product X-Ray Sorting"
  lead="Foreign material is removed in-line, before anything is packed: bulk product flowing on a wide belt is scanned continuously, and on detection only the defective zone is diverted out by an air jet or flap. Minimum product loss, maximum tonnage."
  image={img}
  imageAlt="Bulk product X-ray sorting machine — studio shot"
  urunGruplari={[
    {
      baslik: "Nuts and Dried Fruit",
      urunler: [
        "Hazelnut kernels, almonds, walnuts",
        "Pistachios (including empty/full kernel separation)",
        "Raisins, figs, apricots"
      ]
    },
    {
      baslik: "Pulses and Grains",
      urunler: [
        "Lentils, chickpeas, beans",
        "Bulgur, rice",
        "Seeds and spices"
      ]
    },
    {
      baslik: "Frozen and Fresh",
      urunler: [
        "IQF fruit and vegetables",
        "Potato products",
        "Vegetable mixes"
      ]
    }
  ]}
  avantajlar={[
    {
      icon: "yazilim",
      baslik: "Multi-Channel Sorting",
      text: "Multi-channel software and multi-channel air rejection deliver accurate sorting at high speed — efficiency goes up and unit cost comes down."
    },
    {
      icon: "xray",
      baslik: "Spherical-Product Design",
      text: "A design tailored to spherical bulk products such as hazelnuts and pistachios — high-speed, accurate rejection of foreign material."
    },
    {
      icon: "dogruluk",
      baslik: "Zoned Rejection — Minimum Product Loss",
      text: "Only the defective strip of product is ejected, not a whole pack; product loss is many times lower than with end-of-line systems."
    },
    {
      icon: "parca",
      baslik: "Machine Protection",
      text: "Installed upstream of crushers, mills, and slicers, the X-ray keeps stone and metal from reaching your expensive equipment."
    },
    {
      icon: "garanti",
      baslik: "Radiation-Free Curtain, Safe Build",
      text: "A safety enclosure built for bulk flow with a radiation-free curtain design — hygienic, safe, and a clean fit for your line."
    }
  ]}
  specMatrix={{
    cornerLabel: "Model / SX",
    models: ["40100", "60100", "40100S", "60100S"],
    rows: [
      { label: "Product Type", values: ["Standard Bulk", "Standard Bulk", "Spherical Bulk", "Spherical Bulk"] },
      { label: "Capacity (t/h)", values: ["2–4", "6–10", "2–4", "6–10"] },
      { label: "Detector Width (mm)", values: ["400", "600", "400", "600"] },
      { label: "Detector Height (mm)", values: ["100", "100", "100", "100"] },
      { label: "Sensitivity — Stainless Ball (mm)", values: ["0.3", "0.3", "0.3", "0.3"] },
      { label: "Sensitivity — Stainless Wire (mm)", values: ["0.2×2", "0.2×2", "0.2×2", "0.2×2"] },
