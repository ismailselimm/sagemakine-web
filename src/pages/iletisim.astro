---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE, CONTACT } from '../data/site';
import '../styles/iletisim.css';

const breadcrumbs = [{ name: 'İletişim', path: '/iletisim/' }];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'İletişim — SAGE Makine',
    url: `${SITE.domain}/iletisim/`,
  },
];

const konular = [
  'Renk ayırma makinesi — teklif',
  'X-Ray gıda kontrol — teklif',
  'Numune testi talebi',
  'Teknik servis / arıza',
  'Yedek parça',
  'Diğer',
];
---

<BaseLayout
  title="İletişim – Teklif ve Numune Testi | SAGE Makine"
  description="SAGE Makine iletişim: +90 532 343 61 95, info@sagemakine.com. Güzelyurt Mah. Yunusemre/Manisa. WhatsApp'tan hızlı teklif alın, numune testi planlayalım."
  path="/iletisim/"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="İletişim"
    title="Konuşalım — Bir Telefon Uzaktayız"
    lead="Teklif, numune testi veya servis: en hızlı cevabı telefonla ya da WhatsApp'tan alırsınız. Mesai saatleri içinde genellikle aynı gün döneriz."
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container container--wide iletisim-grid">
      <!-- Sol: kanallar -->
      <div class="kanallar">
        <a href={CONTACT.phoneHref} class="kanal card">
          <span class="kanal-icon"><Icon name="telefon" size={24} /></span>
          <div>
            <h2>Telefon</h2>
            <p class="kanal-deger">{CONTACT.phoneDisplay}</p>
            <p class="kanal-not">Adem Uzan — satış ve servis</p>
          </div>
        </a>

        <a href={CONTACT.whatsapp} class="kanal card kanal--wa" target="_blank" rel="noopener">
          <span class="kanal-icon kanal-icon--wa">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2Zm0 18.1c-1.48 0-2.94-.4-4.2-1.15l-.3-.18-3.12.82.83-3.05-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.25-8.24 8.25Z"/>
            </svg>
          </span>
          <div>
            <h2>WhatsApp</h2>
            <p class="kanal-deger">Hızlı teklif ve fotoğraflı arıza bildirimi</p>
            <p class="kanal-not">Tıklayın, sohbet açılsın</p>
          </div>
        </a>

        <div class="kanal card">
          <span class="kanal-icon"><Icon name="mail" size={24} /></span>
          <div>
            <h2>E-posta</h2>
            <p class="kanal-deger kanal-deger--mail">
              <a href={`mailto:${CONTACT.emailInfo}`}>{CONTACT.emailInfo}</a>
            </p>
            <p class="kanal-not">Teklif ve tüm sorularınız için — mesai içinde genellikle aynı gün dönüş</p>
          </div>
        </div>

        <div class="kanal card">
          <span class="kanal-icon"><Icon name="saat" size={24} /></span>
          <div>
            <h2>Çalışma Saatleri</h2>
            <p class="kanal-deger">{CONTACT.hours}</p>
            <p class="kanal-not">Hasat sezonunda servis için haftanın 7 günü bize ulaşabilirsiniz</p>
          </div>
        </div>

        <div class="kanal card">
          <span class="kanal-icon"><Icon name="harita" size={24} /></span>
          <div>
            <h2>Adres</h2>
            <p class="kanal-deger">{CONTACT.address.street}</p>
            <p class="kanal-not">
              {CONTACT.address.district} / {CONTACT.address.city} ·
              <a href={CONTACT.mapsLink} target="_blank" rel="noopener">Yol tarifi al</a>
            </p>
          </div>
        </div>
      </div>

      <!-- Sağ: WhatsApp form -->
      <div class="form-box">
        <h2>WhatsApp'tan Hızlı Teklif</h2>
        <p class="form-not">
          Aşağıdaki formu doldurun; mesajınız hazır şekilde WhatsApp'ta açılsın. Bilgileriniz sunucuda
          saklanmaz, yalnızca mesajınıza eklenir.
        </p>
        <form id="wa-form" data-wa={CONTACT.whatsapp}>
          <label>
            Adınız ve firmanız
            <input type="text" name="isim" placeholder="Örn: Mehmet Bey — Ege Kuruyemiş" required />
          </label>
          <label>
            Konu
            <select name="konu" required>
              {konular.map((k) => <option value={k}>{k}</option>)}
            </select>
          </label>
          <label>
            Ürününüz ve kapasite (isteğe bağlı)
            <textarea
              name="mesaj"
              rows="3"
              placeholder="Örn: Çekirdeksiz kuru üzüm, saatte 3-4 ton, çöp-sap sorunu"></textarea>
          </label>
          <button type="submit" class="btn btn--primary btn--lg">WhatsApp'ta Aç</button>
          <p class="kvkk-not">
            Gönderirken <a href="/kvkk/">KVKK Aydınlatma Metni</a>'ni kabul etmiş sayılırsınız.
          </p>
        </form>
      </div>
    </div>
  </section>

  <!-- Harita -->
  <section class="map-section">
    <iframe
      src={CONTACT.mapsEmbed}
      title="SAGE Makine konumu — Güzelyurt Mah. Yunusemre/Manisa"
      loading="lazy"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</BaseLayout>

<script>
  /* İki dilin iletişim sayfasında BAYT-AYNI script: ClientRouter tek modül yükler,
     mesaj şablonu çalışma anında <html lang>'den seçilir. */
  function initWaForm() {
    const form = document.getElementById('wa-form') as HTMLFormElement | null;
    if (!form || form.dataset.init) return;
    form.dataset.init = '1';
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const isim = String(data.get('isim') || '').trim();
      const konu = String(data.get('konu') || '');
      const mesaj = String(data.get('mesaj') || '').trim();
      const en = document.documentElement.lang === 'en';
      const text = (en
        ? [
            "Hello, I'm writing via sagemakine.com.",
            isim && `I'm ${isim}.`,
            `Topic: ${konu}.`,
            mesaj && `Details: ${mesaj}`,
          ]
        : [
            'Merhaba, sagemakine.com üzerinden yazıyorum.',
            isim && `Ben ${isim}.`,
            `Konu: ${konu}.`,
            mesaj && `Detay: ${mesaj}`,
          ]
      )
        .filter(Boolean)
        .join(' ');
      window.open(`${form.dataset.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    });
  }
  document.addEventListener('astro:page-load', initWaForm);
</script>
