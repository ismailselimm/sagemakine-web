---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import ColorSorterDiagram from '../../components/diagrams/ColorSorterDiagram.astro';
import { SITE, CONTACT, SECTORS } from '../../data/site';

import { MACHINE_IMAGES } from '../../data/images';
import kameraImg from '../../assets/photos/tech-kamera.png';

const { dmax, havaBlogu, lineIds, linePanorama } = MACHINE_IMAGES;
import '../../styles/pillar-renk.css';

const breadcrumbs = [{ name: 'Renk Ayırma Makineleri', path: '/renk-ayirma-makinesi/' }];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Renk Ayırma Makinesi (Color Sorter)',
    brand: { '@type': 'Brand', name: SITE.name },
    description:
      'Kuru meyve, kuruyemiş ve bakliyat için bant tipi renk ayırma makineleri. Yüksek çözünürlüklü RGB kameralı, hava ejektörlü optik ayıklama sistemleri; kurulum, eğitim ve Türkiye genelinde servisle.',
    image: `${SITE.domain}/og/og-default.jpg`,
    url: `${SITE.domain}/renk-ayirma-makinesi/`,
  },
];

const teknolojiler = [
  {
    icon: 'kamera',
    title: 'Yüksek Çözünürlüklü RGB Kameralar',
    text: 'En küçük renk sapmasını, leke ve beneği LED aydınlatma altında tanır.',
  },
  {
    icon: 'ejektor',
    title: 'Hassas Hava Ejektörleri',
    text: 'Kusurlu taneyi nokta atışı hava darbesiyle hattan çıkarır; sağlam ürün akışına dokunmaz.',
  },
  {
    icon: 'dogruluk',
    title: 'Şekil Ayıklama',
    text: 'Geometri analizi; sap, çöp ve kırık taneyi ürünle aynı renkte olsa bile yakalar.',
  },
  {
    icon: 'yazilim',
    title: 'Derin Öğrenme (Deep Learning) Sınıflandırma',
    text: 'Derin öğrenme modelleri, klasik eşiklerin kaçırdığı karmaşık kusur desenlerini öğrenir.',
  },
];

const kusurlar = [
  { icon: 'tas', label: 'Taş ve toprak' },
  { icon: 'cam', label: 'Cam ve seramik' },
  { icon: 'metal', label: 'Metal parçalar' },
  { icon: 'kabuk', label: 'Kabuk ve çekirdek kırığı' },
  { icon: 'sap', label: 'Sap, çöp, bitkisel kalıntı' },
  { icon: 'kuf', label: 'Küflü ve çürük tane' },
  { icon: 'renk', label: 'Renk kusurlu tane' },
  { icon: 'dogruluk', label: 'Aflatoksin şüpheli koyu tane' },
];

---

<BaseLayout
  title="Renk Ayırma Makinesi (Color Sorter) Satış ve Servis | SAGE Makine"
  description="Bant tipi renk ayırma makineleri: yüksek çözünürlüklü RGB kameralarla renk ve şekil kusurlarını ayıklayın. DMAX modeli, kurulum, eğitim ve yedek parça Türkiye'de."
  path="/renk-ayirma-makinesi/"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow="Optik Ayıklama Teknolojisi"
    title="Renk Ayırma Makineleri"
    lead="Renk ayırma — piyasadaki adıyla renk ayıklama makinesi ya da color sorter — kusurlu taneleri ve yabancı maddeleri kameralarla tespit edip hava ejektörleriyle hattan çıkarır. Kuru meyveden dondurulmuş gıdaya, bant tipi DMAX modelimizle nazik ve doğru ayıklama."
    breadcrumbs={breadcrumbs}
  >
    <Fragment slot="actions">
      <a href={CONTACT.whatsappQuote('Renk ayırma makineleri')} class="btn btn--primary" target="_blank" rel="noopener">Teklif Alın</a>
      <a href="#modeller" class="btn btn--outline pillar-ghost">Modelleri İnceleyin</a>
    </Fragment>
    <Fragment slot="visual">
      <Image
        src={havaBlogu}
        alt="SAGE renk ayırma makinesinin hava ejektör bloğu — hassas hava tabancaları yakın çekim"
        widths={[480, 760, 1100]}
        sizes="(max-width: 900px) 100vw, 42vw"
        loading="eager"
        quality={70}
      />
    </Fragment>
  </PageHero>

  <!-- Nasıl çalışır -->
  <section class="section" id="nasil-calisir">
    <div class="container">
      <p class="eyebrow reveal">Nasıl Çalışır?</p>
      <div class="howto-grid">
        <div class="howto-text reveal">
          <h2>Saniyede Binlerce Tane,<br />Tek Tek Kontrol</h2>
          <ol class="howto-steps">
            <li><strong>Besleme:</strong> Ürün, huniden titreşimli besleyiciye düzenli akışla verilir.</li>
            <li><strong>Akış:</strong> Taneler oluktan (veya bantta tek katman) ince bir perde halinde geçer.</li>
            <li><strong>Tarama:</strong> Yüksek çözünürlüklü RGB kameralar, LED aydınlatma altında her taneyi görüntüler.</li>
            <li><strong>Karar:</strong> İşlemci, milisaniyeler içinde sağlam/kusurlu kararını verir.</li>
            <li><strong>Ayırma:</strong> Hava ejektörü kusurlu taneyi nokta atışıyla ıskartaya üfler.</li>
          </ol>
        </div>
        <div class="reveal" style="--reveal-delay:.1s">
          <ColorSorterDiagram />
        </div>
      </div>
    </div>
  </section>

  <!-- Teknolojiler -->
  <section class="section band-sunken">
    <div class="container container--wide">
      <p class="eyebrow reveal">Kamera ve Yazılım</p>
      <h2 class="reveal">Kusuru Gören Dört Teknoloji</h2>
      <div class="tek-grid">
        {
          teknolojiler.map((t, i) => (
            <div class="tek card reveal" style={`--reveal-delay:${i * 0.08}s`}>
              <span class="tek-icon">
                <Icon name={t.icon as any} size={26} />
              </span>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </div>
          ))
        }
      </div>
      <figure class="tek-figure reveal">
        <Image
          src={kameraImg}
          alt="Ayıklama haznesi içindeki yüksek çözünürlüklü kamera modülü ve LED aydınlatma"
          widths={[700, 1100, 1500]}
          sizes="(max-width: 900px) 100vw, 74rem"
        />
        <figcaption class="mono-cap">KAMERA MODÜLÜ + LED AYDINLATMA — AYIKLAMA HAZNESİ</figcaption>
      </figure>
    </div>
  </section>

  <!-- Modellerimiz -->
  <section class="section" id="modeller">
    <div class="container">
      <p class="eyebrow reveal">Modellerimiz</p>
      <h2 class="reveal">Optik Ayıklama Makinelerimiz</h2>
      <p class="sec-lead reveal">
        Renk ayırma tarafında iki gerçek modelimiz var: bant tipi DMAX ve hassas kuruyemiş
        ayırıcısı IDS. Ürününüze göre doğru olanı birlikte netleştiririz.
      </p>
      <div class="tip-grid">
        <a href="/makineler/dmax/" class="tip-card card reveal">
          <div class="tip-img">
            <Image src={dmax} alt="DMAX bant tipi renk ve şekil ayıklama makinesi" widths={[480, 760]} sizes="(max-width:900px) 100vw, 40vw" />
          </div>
          <div class="tip-body">
            <h3>DMAX — Bant Tipi</h3>
            <p>RGB renk + şekil ayıklama; 360° kamera kabini. Kuru meyve, donmuş sebze-meyve, patates ürünleri.</p>
            <ul>
              <li><Icon name="check" size={15} /> Üzüm, incir, kayısı, iç ceviz</li>
              <li><Icon name="check" size={15} /> IQF meyve-sebze, parmak patates</li>
              <li><Icon name="check" size={15} /> Kırılgan üründe nazik tek katman akış</li>
            </ul>
            <span class="tip-link">DMAX'i inceleyin <Icon name="arrow" size={15} /></span>
          </div>
        </a>
        <a href="/makineler/ids/" class="tip-card card reveal" style="--reveal-delay:.1s">
          <div class="tip-img">
            <Image src={lineIds} alt="IDS hassas kuruyemiş ayırma ve analiz hattı" widths={[480, 760]} sizes="(max-width:900px) 100vw, 40vw" />
          </div>
          <div class="tip-body">
            <h3>IDS — Hassas Kuruyemiş</h3>
            <p>360° kamera, tek geçişte 10 kanala kadar sınıflandırma; kusur + yabancı madde tespiti ve raporlama.</p>
            <ul>
              <li><Icon name="check" size={15} /> İçi dolu ve kabuklu kuruyemiş</li>
              <li><Icon name="check" size={15} /> Boyutlandırma + sınıflandırma</li>
              <li><Icon name="check" size={15} /> Üretim takibi ve analiz raporu</li>
            </ul>
            <span class="tip-link">IDS'yi inceleyin <Icon name="arrow" size={15} /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Neleri ayıklar -->
  <section class="section band-sunken">
    <div class="container">
      <p class="eyebrow reveal">Neleri Ayıklar?</p>
      <h2 class="reveal">Gözden Kaçanı Kamera Kaçırmaz</h2>
      <ul class="kusur-list">
        {
          kusurlar.map((k, i) => (
            <li class="reveal" style={`--reveal-delay:${(i % 4) * 0.06}s`}>
              <Icon name={k.icon as any} size={20} />
              {k.label}
            </li>
          ))
        }
      </ul>
    </div>
  </section>


  <!-- Anahtar teslim hat -->
  <section class="section band-sunken">
    <div class="container container--wide">
      <p class="eyebrow reveal">Hat Çözümleri</p>
      <div class="sec-head reveal">
        <h2>Tek Makineden Komple Hatta</h2>
        <p>
          Elevatör, besleme, ayırma ve kontrol adımlarını tek proje olarak planlıyoruz; makineniz
          hatta yalnız kalmaz.
        </p>
      </div>
      <figure class="hat-panorama reveal">
        <Image
          src={linePanorama}
          alt="Anahtar teslim ayıklama hattı: elevatörler, besleme hunileri, renk ayırıcı ve paketleme hattı bir arada"
          widths={[768, 1200, 1800, 2400]}
          sizes="(max-width: 1440px) 100vw, 1376px"
        />
        <figcaption class="mono-cap">ANAHTAR TESLİM HAT KURULUMU — ÖRNEK YERLEŞİM</figcaption>
      </figure>
      <figure class="hat-figure reveal" style="--reveal-delay:.1s">
        <Image
          src={lineIds}
          alt="Besleme, ayırma ve analiz konveyöründen oluşan ayıklama hattı"
          widths={[700, 1100, 1500]}
          sizes="(max-width: 900px) 100vw, 74rem"
        />
        <figcaption class="mono-cap">BESLEME + AYIRMA + KONTROL — HAT ÜZERİNDE ANALİZ</figcaption>
      </figure>
    </div>
  </section>

  <!-- Dürüst satın alma rehberi -->
  <section class="section honest-band band-dark">
    <div class="container honest-in">
      <p class="eyebrow reveal">Doğru Soruları Sorun</p>
      <h2 class="reveal">Yalnızca "Doğruluk Yüzdesine" Bakmayın</h2>
      <div class="honest-grid">
        <div class="honest card-dark reveal">
          <h3><Icon name="dogruluk" size={20} /> Taşıma Oranı</h3>
          <p>
            Iskartaya kaçan sağlam ürün (carryover), işletme kârınızı doğruluk kadar etkiler.
            Teklifte iyi/kötü taşıma oranını mutlaka sorun — biz açıkça paylaşırız.
          </p>
        </div>
        <div class="honest card-dark reveal" style="--reveal-delay:.08s">
          <h3><Icon name="kapasite" size={20} /> Hava Tüketimi</h3>
          <p>
            Ejektörlerin hava tüketimi, kompresör yatırımı ve elektrik faturası demektir.
            L/dk değerini ve gereken basıncı teklifle birlikte isteyin.
          </p>
        </div>
        <div class="honest card-dark reveal" style="--reveal-delay:.16s">
          <h3><Icon name="parca" size={20} /> Servis Gerçeği</h3>
          <p>
            Makine Çin'den gelir; servis Manisa'dan. Ejektör valfi, kamera ve LED modülü gibi
            kritik parçaların Türkiye'de stokta olup olmadığını sorun.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Sektörler -->
  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Uygulamalar</p>
      <nav class="sektor-strip" aria-label="Sektörler">
        {SECTORS.map((s) => <a href={`/sektorler/${s.slug}/`}>{s.title}</a>)}
      </nav>
    </div>
  </section>

  <CtaBand
    title="Ürününüz İçin Teklif Alın"
    text="Ürününüzü, kapasitenizi ve kusur profilinizi anlatın; doğru modeli ve konfigürasyonu birlikte netleştirelim."
    topic="Renk ayırma makinesi teklifi"
  />
</BaseLayout>

