---
import SektorPage from '../../components/SektorPage.astro';
import { SEKTORLER } from '../../data/sektorler';

export function getStaticPaths() {
  return SEKTORLER.map((sektor) => ({ params: { slug: sektor.slug }, props: { sektor } }));
}

const { sektor } = Astro.props;
---

<SektorPage sektor={sektor} sektorler={SEKTORLER} />
