---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { SEKTORLER } from '../../data/sektorler';
import { CONTACT } from '../../data/site';
import { t } from '../../i18n/ui';

const ui = t('tr');

export function getStaticPaths() {
  return SEKTORLER.map((sektor) => ({ params: { slug: sektor.slug }, props: { sektor } }));
}

const { sektor } = Astro.props;

// yalnızca kullanılan görseller — glob tüm klasörü işleyip kullanılmayanları da dist'e taşıyordu
import sectorKuruUzum from '../../assets/photos/sector-kuru-uzum.png';
import sectorFindik from '../../assets/photos/sector-kuruyemis-findik.png';
import sectorFistik from '../../assets/photos/sector-antep-fistigi.png';
import sectorMercimek from '../../assets/photos/sector-bakliyat-mercimek.png';
import sectorIqf from '../../assets/photos/sector-iqf.png';
import sectorPatates from '../../assets/photos/sector-patates.png';
import foodIncir from '../../assets/photos/food-incir.png';
import sortingOnceSonra from '../../assets/photos/sorting-oncesi-sonrasi.png';

const photos: Record<string, ImageMetadata> = {
  'sector-kuru-uzum': sectorKuruUzum,
  'sector-kuruyemis-findik': sectorFindik,
  'sector-antep-fistigi': sectorFistik,
  'sector-bakliyat-mercimek': sectorMercimek,
  'sector-iqf': sectorIqf,
  'sector-patates': sectorPatates,
  'food-incir': foodIncir,
  'sorting-oncesi-sonrasi': sortingOnceSonra,
};
const heroImg = photos[sektor.image];
const extraImg = sektor.extraImage ? photos[sektor.extraImage] : undefined;

const breadcrumbs = [
  { name: ui.sekSektorLink, path: `/sektorler/${SEKTORLER[0].slug}/` },
  { name: sektor.title, path: `/sektorler/${sektor.slug}/` },
];

const digerSektorler = SEKTORLER.filter((s) => s.slug !== sektor.slug);
---

<BaseLayout
  title={sektor.metaTitle}
  description={sektor.metaDescription}
  path={`/sektorler/${sektor.slug}/`}
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow={sektor.eyebrow}
    title={sektor.heroTitle}
    lead={sektor.heroLead}
    breadcrumbs={breadcrumbs}
  >
    <Fragment slot="actions">
      <a
        href={CONTACT.whatsappQuote(sektor.waTopic)}
        class="btn btn--primary"
        target="_blank"
        rel="noopener">{ui.quoteBtn}</a
      >
      <a href="#cozum" class="btn btn--outline hero-ghost">{ui.sekHeroCta}</a>
    </Fragment>
    <Fragment slot="visual">
      <Image
        src={heroImg}
        alt={sektor.imageAlt}
        widths={[480, 760, 1100]}
        sizes="(max-width: 900px) 100vw, 42vw"
        loading="eager"
        quality={65}
      />
    </Fragment>
  </PageHero>

  <!-- Sektör gerçekleri -->
  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">{ui.sekTaniyoruz}</p>
      <div class="facts-grid">
        <p class="facts-intro reveal">{sektor.factsIntro}</p>
        <div class="facts">
          {
            sektor.facts.map((f, i) => (
              <div class="fact reveal" style={`--reveal-delay:${i * 0.08}s`}>
                <span class="fact-stat">{f.stat}</span>
                <span class="fact-label">{f.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Kusurlar -->
  <section class="section band-sunken">
    <div class="container">
      <p class="eyebrow reveal">{ui.sekKusurEyebrow}</p>
      <h2 class="reveal">{ui.sekKusurH2}</h2>
      <div class="defect-grid">
        {
          sektor.defects.map((d, i) => (
            <div class="defect card reveal" style={`--reveal-delay:${(i % 3) * 0.08}s`}>
              <span class="defect-icon">
                <Icon name={d.icon as any} size={26} />
              </span>
              <h3>{d.label}</h3>
              <p>{d.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Önerilen çözüm -->
  <section class="section" id="cozum">
    <div class="container">
      <p class="eyebrow reveal">{ui.sekKurulumEyebrow}</p>
      <h2 class="reveal">{ui.sekKurulumH2}</h2>
      <p class="cozum-intro reveal">{sektor.cozum.intro}</p>

      <div class:list={['cozum-grid', { 'has-figure': !!extraImg }]}>
        {
          sektor.cozum.adimlar.map((a, i) => (
            <a href={a.href} class="cozum-card card reveal" style={`--reveal-delay:${i * 0.1}s`}>
              <span class="cozum-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{a.baslik}</h3>
                <p>{a.text}</p>
                <span class="cozum-link">
                  {a.linkLabel}
                  <Icon name="arrow" size={16} />
                </span>
              </div>
            </a>
          ))
        }
        {
          extraImg && (
            <figure class="cozum-figure reveal" style="--reveal-delay:.2s">
              <Image
                src={extraImg}
                alt={sektor.extraImageAlt ?? ''}
                widths={[480, 760]}
                sizes="(max-width: 900px) 100vw, 32vw"
              />
            </figure>
          )
        }
      </div>
    </div>
  </section>

  <!-- Servis notu -->
  <section class="section--tight section band-sunken">
    <div class="container servis-note reveal">
      <span class="servis-icon"><Icon name="harita" size={28} /></span>
      <div>
        <h2>{ui.sekBolge}</h2>
        <p>{sektor.servisNotu}</p>
        <a href="/servis-yedek-parca/" class="cozum-link"
          >{ui.sekServisLink} <Icon name="arrow" size={16} /></a
        >
      </div>
    </div>
  </section>

  <!-- Diğer sektörler -->
  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">{ui.sekDiger}</p>
      <nav class="sektor-strip" aria-label={ui.sekDigerAria}>
        {digerSektorler.map((s) => <a href={`/sektorler/${s.slug}/`}>{s.title}</a>)}
      </nav>
    </div>
  </section>

  <CtaBand title={ui.sekCtaTitle} text={ui.sekCtaText} topic={sektor.waTopic} />
</BaseLayout>

<style>
  .facts-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--sp-7);
    align-items: start;
  }

  .facts-intro {
    font-size: var(--text-lg);
    color: var(--ink-soft);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
  }

  .fact {
    border-top: 2px solid var(--green-500);
    padding-top: var(--sp-4);
    display: grid;
    gap: var(--sp-2);
    align-content: start;
  }

  .fact-stat {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' var(--wdth-wide);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--navy-800);
    line-height: 1;
  }

  .fact-label {
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .defect-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5);
    margin-top: var(--sp-6);
  }

  .defect {
    padding: var(--sp-5);
  }

  .defect h3 {
    font-size: var(--text-md);
    margin-bottom: var(--sp-2);
  }

  .defect p {
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .cozum-intro {
    margin-top: var(--sp-4);
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: 62ch;
  }

  .cozum-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    margin-top: var(--sp-6);
    align-items: stretch;
  }

  /* yan görsel varsa üçüncü sütun açılır */
  .cozum-grid.has-figure {
    grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 0.9fr);
  }

  .cozum-card {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-5);
    text-decoration: none;
  }

  .cozum-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    align-self: start;
    padding: 0.3em 0.5em;
  }

  .cozum-card h3 {
    font-size: var(--text-md);
    margin-bottom: var(--sp-2);
  }

  .cozum-card p {
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .cozum-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--sp-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-ink);
  }

  .cozum-card:hover .cozum-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cozum-figure {
    margin: 0;
  }

  .cozum-figure :global(img) {
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .servis-note {
    display: flex;
    gap: var(--sp-5);
    align-items: start;
  }

  .servis-icon {
    display: inline-flex;
    padding: 0.8rem;
    background: var(--green-100);
    color: var(--accent-ink);
    border-radius: var(--radius-md);
  }

  .servis-note h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--sp-2);
  }

  .servis-note p {
    color: var(--ink-soft);
    max-width: 70ch;
  }

  @media (max-width: 1000px) {
    .cozum-grid,
    .cozum-grid.has-figure {
      grid-template-columns: 1fr 1fr;
    }
    .cozum-figure {
      grid-column: 1 / -1;
    }
    .cozum-figure :global(img) {
      max-height: 320px;
      width: 100%;
    }
  }

  @media (max-width: 900px) {
    .facts-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }
    .defect-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .defect-grid,
    .cozum-grid,
    .facts {
      grid-template-columns: 1fr;
    }
    .facts {
      gap: var(--sp-4);
    }
    .servis-note {
      flex-direction: column;
    }
  }
</style>
